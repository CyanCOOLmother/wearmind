[Unit]
Description=WearMind local Qwen 2.5 model (CPU)
After=local-fs.target

[Service]
Type=simple
User=cix
WorkingDirectory=/home/cix/wearmind-ai
ExecStart=/usr/share/cix/bin/llama-server -m /home/cix/wearmind-ai/qwen2.5-1.5b-instruct-q4_k_m.gguf --alias wearmind-qwen2.5-1.5b --host 127.0.0.1 --port 8080 -t 4 -c 2048 -ngl 0
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/cix/wearmind-ai/model.log
StandardError=append:/home/cix/wearmind-ai/model.log

[Install]
WantedBy=multi-user.target
